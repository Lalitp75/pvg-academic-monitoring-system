{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pvg-academic-monitoring-system",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "build": {
    "command": "pnpm build"
  },
  "observability": {
    "enabled": true
  }
}
