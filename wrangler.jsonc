{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pvg-academic-monitoring-system",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pvg-academic-monitoring-db",
      "database_id": "455e7d7b-47b7-41e5-8d9e-111a5c4a3567"
    }
  ],
  "build": {
    "command": "pnpm build"
  },
  "observability": {
    "enabled": true
  }
}
